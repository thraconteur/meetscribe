# Copy to .env and fill in. One free Groq key runs all three models.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=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

# ---- Models (defaults shown; any OpenAI-compatible endpoint works) ----
# Stage 1: speech-to-text
STT_BACKEND=api                    # api | local  (local = faster-whisper on this machine)
STT_MODEL=whisper-large-v3         # or whisper-large-v3-turbo (faster, slightly less accurate)
# LOCAL_WHISPER_MODEL=large-v3     # used when STT_BACKEND=local (small.en / medium.en on CPU)

# Stage 2: transcript refinement LM
REFINE_MODEL=openai/gpt-oss-120b

# Stage 3: meeting documentation LM
DOCUMENT_MODEL=openai/gpt-oss-120b
DOCUMENT_REASONING_EFFORT=medium   # low | medium | high | none

# ---- Using a different provider for a stage (example: OpenAI for documentation) ----
# DOCUMENT_BASE_URL=https://api.openai.com/v1
# DOCUMENT_API_KEY=sk-...
# DOCUMENT_MODEL=gpt-4.1
# Local models via Ollama:  REFINE_BASE_URL=http://localhost:11434/v1  REFINE_API_KEY=ollama  REFINE_MODEL=qwen2.5:14b

# ---- Tuning ----
# STT_CHUNK_SECONDS=600            # long recordings are split at pauses near this length
# REFINE_CHUNK_WORDS=1400
# DOCUMENT_MAX_WORDS=3000          # longer transcripts use map-reduce (fits Groq free-tier limits)
# EVIDENCE_MATCH_THRESHOLD=82      # fuzzy match % needed for a quote to count as evidence
# MAX_UPLOAD_MB=500
# MAX_DURATION_MIN=180
